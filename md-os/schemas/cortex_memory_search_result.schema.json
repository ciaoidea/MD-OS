{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/cortex_memory_search_result.schema.json",
  "title": "Bounded Cortex Memory Search Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "status",
    "mutation_authority",
    "query_hash",
    "index_hash",
    "pack_hash",
    "retrieval_mode",
    "limits",
    "selected_nodes",
    "admission_trace",
    "omitted_trace_count",
    "omitted_result_node_count"
  ],
  "properties": {
    "$schema": { "const": "../../../schemas/cortex_memory_search_result.schema.json" },
    "schema_version": { "const": 1 },
    "status": { "enum": ["verified", "empty"] },
    "mutation_authority": { "const": false },
    "query_hash": { "$ref": "#/$defs/hash" },
    "index_hash": { "$ref": "#/$defs/hash" },
    "pack_hash": { "$ref": "#/$defs/hash" },
    "retrieval_mode": { "enum": ["ordinary", "assistant_audit"] },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_nodes", "maximum_chars"],
      "properties": {
        "maximum_nodes": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maximum_chars": { "type": "integer", "minimum": 1024, "maximum": 4096 }
      }
    },
    "selected_nodes": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "object" }
    },
    "admission_trace": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "object" }
    },
    "omitted_trace_count": { "type": "integer", "minimum": 0 },
    "omitted_result_node_count": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
