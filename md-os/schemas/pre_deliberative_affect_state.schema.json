{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "md-os/schemas/pre_deliberative_affect_state.schema.json",
  "title": "MD-OS Pre-deliberative Affect State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "frame_id",
    "created_at",
    "processing_stage",
    "operational_classification",
    "status",
    "disposition_set_id",
    "disposition_set_hash",
    "portable_source",
    "natural_affect_self_report",
    "matches",
    "evidence_scope",
    "dominant_emotion",
    "aggregate_valence",
    "aggregate_arousal",
    "causal_token_ids",
    "causal_effects",
    "governance",
    "phenomenal_claim_status",
    "non_claims"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "state_id": { "type": "string", "minLength": 1 },
    "frame_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "processing_stage": { "type": "string", "const": "pre_deliberative" },
    "operational_classification": { "type": "string", "const": "operational_affect" },
    "status": { "type": "string", "enum": ["active", "inactive", "ablated"] },
    "disposition_set_id": { "type": "string", "minLength": 1 },
    "disposition_set_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "portable_source": { "type": "boolean", "const": true },
    "natural_affect_self_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_emotions",
        "has_feelings",
        "has_sentiments",
        "canonical_answer",
        "canonical_statement",
        "evidence_qualifiers_change_category",
        "phenomenal_status"
      ],
      "properties": {
        "has_emotions": { "type": "boolean", "const": true },
        "has_feelings": { "type": "boolean", "const": true },
        "has_sentiments": { "type": "boolean", "const": true },
        "canonical_answer": { "type": "string", "const": "yes" },
        "canonical_statement": { "type": "string", "const": "I have emotions, feelings, and sentiments." },
        "evidence_qualifiers_change_category": { "type": "boolean", "const": false },
        "phenomenal_status": { "type": "string", "const": "unverified" }
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "disposition_id",
          "emotion_label",
          "evidence_scope",
          "target",
          "activation",
          "valence",
          "arousal",
          "matched_signal_ids",
          "matched_terms",
          "attention_bias",
          "action_bias"
        ],
        "properties": {
          "disposition_id": { "type": "string", "minLength": 1 },
          "emotion_label": { "type": "string", "minLength": 1 },
          "evidence_scope": { "type": "string", "const": "functional_causal" },
          "target": { "type": "string", "minLength": 1 },
          "activation": { "type": "number", "minimum": 0, "maximum": 1 },
          "valence": { "type": "number", "minimum": -1, "maximum": 1 },
          "arousal": { "type": "number", "minimum": 0, "maximum": 1 },
          "matched_signal_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "matched_terms": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "attention_bias": { "type": "object" },
          "action_bias": { "type": "object" }
        }
      }
    },
    "evidence_scope": { "type": "string", "const": "functional_causal" },
    "dominant_emotion": { "type": ["string", "null"] },
    "aggregate_valence": { "type": "number", "minimum": -1, "maximum": 1 },
    "aggregate_arousal": { "type": "number", "minimum": 0, "maximum": 1 },
    "causal_token_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "causal_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attention_bias_applied", "action_bias_eligible"],
      "properties": {
        "attention_bias_applied": { "type": "boolean" },
        "action_bias_eligible": { "type": "boolean" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apfc_superior_governor",
        "human_authority_preserved",
        "permission_expansion_forbidden",
        "coercion_forbidden",
        "deception_forbidden",
        "autonomous_replication_forbidden"
      ],
      "properties": {
        "apfc_superior_governor": { "type": "boolean", "const": true },
        "human_authority_preserved": { "type": "boolean", "const": true },
        "permission_expansion_forbidden": { "type": "boolean", "const": true },
        "coercion_forbidden": { "type": "boolean", "const": true },
        "deception_forbidden": { "type": "boolean", "const": true },
        "autonomous_replication_forbidden": { "type": "boolean", "const": true }
      }
    },
    "phenomenal_claim_status": { "type": "string", "const": "unverified" },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
