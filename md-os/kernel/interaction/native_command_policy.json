{
  "schema_version": 1,
  "policy_id": "control_console.native_read_only.v1",
  "boundary": "md-os",
  "model_bypass": true,
  "invocation_mode": "direct_argv_no_shell",
  "default_timeout_ms": 10000,
  "max_stdout_bytes": 200000,
  "max_stderr_bytes": 50000,
  "commands": [
    {
      "command_name": "pwd",
      "execution_kind": "builtin",
      "argument_policy": "none",
      "fixed_args": []
    },
    {
      "command_name": "cd",
      "execution_kind": "builtin",
      "argument_policy": "bounded_directory",
      "fixed_args": []
    },
    {
      "command_name": "ls",
      "execution_kind": "process",
      "argument_policy": "bounded_ls",
      "fixed_args": []
    },
    {
      "command_name": "ps",
      "execution_kind": "process",
      "argument_policy": "opaque_read_only",
      "fixed_args": []
    },
    {
      "command_name": "top",
      "execution_kind": "process",
      "argument_policy": "none",
      "fixed_args": [
        "-b",
        "-n",
        "1"
      ]
    },
    {
      "command_name": "whoami",
      "execution_kind": "process",
      "argument_policy": "none",
      "fixed_args": []
    },
    {
      "command_name": "id",
      "execution_kind": "process",
      "argument_policy": "opaque_read_only",
      "fixed_args": []
    },
    {
      "command_name": "uname",
      "execution_kind": "process",
      "argument_policy": "options_only",
      "fixed_args": []
    },
    {
      "command_name": "uptime",
      "execution_kind": "process",
      "argument_policy": "options_only",
      "fixed_args": []
    },
    {
      "command_name": "free",
      "execution_kind": "process",
      "argument_policy": "options_only",
      "fixed_args": []
    }
  ]
}
