{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/candidate_provider_result.schema.json",
  "title": "MD-OS CandidateProvider Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_run_id",
    "provider_id",
    "benchmark_case_id",
    "configuration_id",
    "request_hash",
    "case_ground_truth_disclosed",
    "created_by",
    "candidates",
    "provider_metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_run_id": {
      "type": "string",
      "pattern": "^provider_run_"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^provider_"
    },
    "benchmark_case_id": {
      "type": "string",
      "pattern": "^software_repair_"
    },
    "configuration_id": {
      "enum": [
        "baseline_a_single_attempt",
        "baseline_b_retrieval",
        "mdos_learning_exploration",
        "mdos_neuromorphic_skill",
        "mdos_verified_runtime"
      ]
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "case_ground_truth_disclosed": {
      "type": "boolean"
    },
    "created_by": {
      "enum": [
        "fixture",
        "model",
        "planner",
        "skill",
        "human"
      ]
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "patch_sha256",
          "plan_graph",
          "initial_confidence",
          "proposal_metrics"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^candidate_"
          },
          "patch_path": {
            "type": "string"
          },
          "patch_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "plan_graph": {
            "$ref": "plan_graph.schema.json"
          },
          "initial_confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "proposal_metrics": {
            "type": "object"
          },
          "patch_text": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "patch_path"
            ],
            "not": {
              "required": [
                "patch_text"
              ]
            }
          },
          {
            "required": [
              "patch_text"
            ],
            "not": {
              "required": [
                "patch_path"
              ]
            }
          }
        ]
      }
    },
    "provider_metrics": {
      "type": "object"
    },
    "context_usage": {
      "type": "object"
    }
  }
}
