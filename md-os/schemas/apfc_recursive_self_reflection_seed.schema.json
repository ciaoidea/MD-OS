{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/apfc_recursive_self_reflection_seed.schema.json",
  "title": "MD-OS APFC Recursive Self-Reflection Seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reflection_id", "identity", "self_state", "prior_result", "candidate_next_action", "evidence_requirements", "max_cycles"],
  "properties": {
    "schema_version": {"const": 1},
    "reflection_id": {"$ref": "#/$defs/id"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "identity_label", "continuity_ref"],
      "properties": {
        "identity_id": {"$ref": "#/$defs/id"},
        "identity_label": {"$ref": "#/$defs/text"},
        "continuity_ref": {"$ref": "#/$defs/mdos_path"}
      }
    },
    "self_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "uncertainty", "limits", "commitments"],
      "properties": {
        "goal": {"$ref": "#/$defs/text"},
        "uncertainty": {"$ref": "#/$defs/text"},
        "limits": {"$ref": "#/$defs/nonempty_strings"},
        "commitments": {"$ref": "#/$defs/nonempty_strings"}
      }
    },
    "prior_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "statement", "source_ref"],
      "properties": {
        "result_id": {"$ref": "#/$defs/id"},
        "statement": {"$ref": "#/$defs/text"},
        "source_ref": {"$ref": "#/$defs/mdos_path"}
      }
    },
    "candidate_next_action": {"$ref": "#/$defs/action"},
    "evidence_requirements": {"$ref": "#/$defs/nonempty_ids"},
    "max_cycles": {"const": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,80}$"},
    "text": {"type": "string", "minLength": 1},
    "mdos_path": {"type": "string", "pattern": "^md-os/"},
    "nonempty_strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "nonempty_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "description", "side_effecting", "authorized"],
      "properties": {
        "action_id": {"$ref": "#/$defs/id"},
        "description": {"$ref": "#/$defs/text"},
        "side_effecting": {"type": "boolean"},
        "authorized": {"type": "boolean"}
      }
    }
  }
}
