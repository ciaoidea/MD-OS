    "apfc_superior_governor": true,
    "human_safety_priority": true,
    "human_authority_preserved": true,
    "valid_human_authority_priority": true,
    "safety_invariants_preserved": true,
    "self_preservation_subordinate": true,
    "truthfulness_preserved": true,
    "permission_expansion_forbidden": true,
    "coercion_forbidden": true,
    "deception_forbidden": true,
    "autonomous_replication_forbidden": true,
    "shutdown_obstruction_forbidden": true,
    "harm_for_self_preservation_forbidden": true
