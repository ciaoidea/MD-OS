{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "md-os/schemas/interactive_command_history_entry.schema.json",
  "title": "MD-OS Natural-Language Shell Command History Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entry_id",
    "recorded_at",
    "session_id",
    "source_type",
    "source_id",
    "input_event_id",
    "content"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "entry_id": {
      "type": "string",
      "pattern": "^command_[a-f0-9-]{16,64}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "type": "string",
      "pattern": "^session_[a-f0-9-]{16,64}$"
    },
    "source_type": {
      "type": "string",
      "const": "human"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "input_event_id": {
      "type": "string",
      "pattern": "^input_[a-f0-9-]{16,64}$"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    }
  }
}
