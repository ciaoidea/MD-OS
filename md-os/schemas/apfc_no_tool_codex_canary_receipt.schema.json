{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.org/schemas/apfc_no_tool_codex_canary_receipt.schema.json",
  "title": "APFC no-tool Codex patch canary receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_type", "backend_id", "model",
    "model_reasoning_effort", "execution_mode", "response_schema_hash",
    "started_at", "completed_at", "model_exit_status", "model_timed_out",
    "authentication_failure_detected", "tool_event_types", "tool_use_detected",
    "structured_response_valid", "patch_apply_error", "response_hash",
    "changed_files", "candidate_patch_hash", "candidate_patch_bytes",
    "verifier_exit_status", "stdout_hash", "stderr_hash", "verified",
    "laboratory_disposed", "receipt_hash"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_type": { "const": "apfc_host_native_codex_canary" },
    "backend_id": { "const": "host_native_no_tool_ephemeral_v2" },
    "model": { "type": "string", "minLength": 1 },
    "model_reasoning_effort": { "const": "low" },
    "execution_mode": { "const": "model_no_local_tools_runner_applies_patch" },
    "response_schema_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "started_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": "string", "minLength": 1 },
    "model_exit_status": { "type": ["integer", "null"] },
    "model_timed_out": { "type": "boolean" },
    "authentication_failure_detected": { "type": "boolean" },
    "tool_event_types": { "type": "array", "items": { "type": "string" } },
    "tool_use_detected": { "type": "boolean" },
    "structured_response_valid": { "type": "boolean" },
    "patch_apply_error": { "type": ["string", "null"] },
    "response_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "candidate_patch_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_patch_bytes": { "type": "integer", "minimum": 0 },
    "verifier_exit_status": { "type": ["integer", "null"] },
    "stdout_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stderr_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verified": { "type": "boolean" },
    "laboratory_disposed": { "type": "boolean" },
    "receipt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
