{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/agi_sal_score.schema.json",
  "title": "MD-OS SAL AGI score readback",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "score_id",
    "generated_at",
    "sal_score",
    "evidence_level",
    "axes",
    "hard_gates",
    "claim_state"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "score_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "sal_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "evidence_level": {
      "enum": ["internal_only", "external_partial", "externally_supported", "externally_failed"]
    },
    "axes": { "type": "object" },
    "hard_gates": { "type": "object" },
    "claim_state": {
      "type": "object",
      "required": ["operational_agi_claim_supported", "agi_achieved", "reason"],
      "properties": {
        "operational_agi_claim_supported": { "type": "boolean" },
        "agi_achieved": { "const": "not_ontologically_attestable" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
