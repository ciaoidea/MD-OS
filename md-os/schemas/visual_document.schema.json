{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/visual_document.schema.json",
  "title": "MD-OS visual document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "title",
    "revision",
    "updated_at",
    "blocks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "title": { "type": "string", "maxLength": 240 },
    "revision": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string", "format": "date-time" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block_id": {
      "type": "string",
      "pattern": "^b_[a-f0-9]{16,32}$"
    },
    "rich_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "html"],
      "properties": {
        "id": { "$ref": "#/$defs/block_id" },
        "type": { "const": "rich" },
        "html": { "type": "string", "maxLength": 2000000 }
      }
    },
    "table_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "html"],
      "properties": {
        "id": { "$ref": "#/$defs/block_id" },
        "type": { "const": "table" },
        "html": { "type": "string", "maxLength": 2000000 }
      }
    },
    "formula_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "latex", "mathml", "display"],
      "properties": {
        "id": { "$ref": "#/$defs/block_id" },
        "type": { "const": "formula" },
        "latex": { "type": "string", "maxLength": 5000 },
        "mathml": { "type": "string", "maxLength": 100000 },
        "display": { "type": "boolean" }
      }
    },
    "image_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "data_uri", "alt", "width_percent"],
      "properties": {
        "id": { "$ref": "#/$defs/block_id" },
        "type": { "const": "image" },
        "data_uri": {
          "type": "string",
          "pattern": "^data:image/(png|jpeg|gif|webp);base64,"
        },
        "alt": { "type": "string", "maxLength": 500 },
        "width_percent": { "type": "integer", "minimum": 10, "maximum": 100 }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/rich_block" },
        { "$ref": "#/$defs/table_block" },
        { "$ref": "#/$defs/formula_block" },
        { "$ref": "#/$defs/image_block" }
      ]
    }
  }
}
