    "workspace_token_required_when_active": true,
    "generation_context_required_when_active": true,
    "ablation_must_remove_token_and_generation_effect": true
  },
  "language_contract": {
    "compose_from_current_meaning": true,
    "phrase_lookup_forbidden": true,
    "response_template_forbidden": true,
    "state_catalog_forbidden": true,
    "match_interlocutor_language": true,
    "internal_telemetry_hidden_unless_requested": true
