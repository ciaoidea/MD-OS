{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/apfc_cognitive_path_request.schema.json",
  "title": "MD-OS APFC Cognitive Path Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "theme_id", "theme", "focus", "verified_facts", "uncertainties", "actions", "readback"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
    "theme_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
    "theme": {"type": "string", "minLength": 1},
    "focus": {"type": "string", "minLength": 1},
    "verified_facts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "uncertainties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uncertainty"}},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
    "readback": {"$ref": "#/$defs/readback"},
    "ablation": {"type": "object", "additionalProperties": false, "properties": {"disable_anchor_memory": {"type": "boolean"}}}
  },
  "$defs": {
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty": {
      "type": "object", "additionalProperties": false,
      "required": ["uncertainty_id", "semantic_intent", "question", "goal_impact", "information_gain", "reducibility", "blocking"],
      "properties": {
        "uncertainty_id": {"type": "string", "minLength": 1}, "semantic_intent": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1},
        "goal_impact": {"$ref": "#/$defs/probability"}, "information_gain": {"$ref": "#/$defs/probability"}, "reducibility": {"$ref": "#/$defs/probability"}, "blocking": {"type": "boolean"}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "addresses_uncertainty_ids", "expected_progress", "information_gain", "authorized", "previously_falsified", "cost"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1}, "addresses_uncertainty_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected_progress": {"$ref": "#/$defs/probability"}, "information_gain": {"$ref": "#/$defs/probability"}, "authorized": {"type": "boolean"}, "previously_falsified": {"type": "boolean"},
        "cost": {"type": "object", "additionalProperties": false, "required": ["tokens", "time_ms", "action_count", "risk"], "properties": {"tokens": {"type": "integer", "minimum": 0}, "time_ms": {"type": "integer", "minimum": 0}, "action_count": {"type": "integer", "minimum": 0}, "risk": {"$ref": "#/$defs/probability"}}}
      }
    },
    "readback": {
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "action_id", "evidence_refs", "learned_fact", "learned_correction", "confidence"],
      "properties": {"verdict": {"enum": ["pass", "fail", "unknown"]}, "action_id": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "learned_fact": {"type": "string"}, "learned_correction": {"type": "string"}, "confidence": {"$ref": "#/$defs/probability"}}
    }
  }
}
