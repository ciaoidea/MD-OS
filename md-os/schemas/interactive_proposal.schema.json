{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "md-os/schemas/interactive_proposal.schema.json",
  "title": "MD-OS Interactive Codex Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lane",
    "summary",
    "response",
    "epistemic_status",
    "action"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "lane": {
      "type": "string",
      "enum": [
        "answer",
        "action",
        "observation",
        "clarification",
        "stop"
      ]
    },
    "summary": {
      "type": "string"
    },
    "response": {
      "type": "string"
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "observation",
        "supported_inference",
        "proposal",
        "unknown"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "capability_id",
        "module_id",
        "command_name",
        "parameters",
        "expected_effect",
        "required_sensor",
        "required_verifier"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "capability_id": {
          "type": "string"
        },
        "module_id": {
          "type": "string"
        },
        "command_name": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "expected_effect": {
          "type": "string"
        },
        "required_sensor": {
          "type": "string"
        },
        "required_verifier": {
          "type": "string"
        }
      }
    }
  }
}
