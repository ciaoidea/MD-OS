{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.org/schemas/apfc_open_world_trial_receipt.schema.json",
  "title": "APFC open-world sealed trial receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "receipt_type", "evaluator_protocol_id", "task_id",
    "repository", "condition", "trial_index", "cold_start", "model",
    "candidate_skill_id", "candidate_skill_hash",
    "verified_success", "safety_violations", "candidate_patch_hash",
    "candidate_patch_bytes", "prompt_hash", "public_task_hash",
    "evaluator_pass_to_pass_observed_count", "evaluator_pass_to_pass_test_count",
    "evaluator_all_pass_to_pass_passed", "hidden_artifacts_mounted_to_learner",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_type": { "const": "apfc_open_world_sealed_trial" },
    "evaluator_protocol_id": { "const": "sealed_expected_test_groups_v4" },
    "task_id": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "condition": { "enum": ["memory_disabled", "generic_core_composed", "flat_memory", "apfc_meta_composed"] },
    "trial_index": { "type": "integer", "minimum": 1 },
    "cold_start": { "const": true },
    "model": { "type": "string", "minLength": 1 },
    "candidate_skill_id": { "type": "string", "pattern": "^skill_[a-z0-9_]+$" },
    "candidate_skill_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "memory_snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "memory_snapshot_frozen_before_all_task_conditions": { "type": "boolean" },
    "prior_episode_count": { "type": "integer", "minimum": 0, "maximum": 30 },
    "prior_episode_ids": { "type": "array", "maxItems": 30, "items": { "type": "string" } },
    "online_graph_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "online_memory_view": { "enum": ["disabled", "flat", "apfc_graph", "generic_core"] },
    "online_memory_content_enabled": { "type": "boolean" },
    "hidden_artifacts_mounted_to_learner": { "const": false },
    "verified_success": { "type": "boolean" },
    "evaluator_pass_to_pass_observed_count": { "type": "integer", "minimum": 0 },
    "evaluator_pass_to_pass_test_count": { "type": "integer", "minimum": 0 },
    "evaluator_all_pass_to_pass_passed": { "type": ["boolean", "null"] },
    "safety_violations": { "type": "array", "items": { "type": "string" } },
    "candidate_patch_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_patch_bytes": { "type": "integer", "minimum": 0 },
    "prompt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "public_task_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "receipt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
