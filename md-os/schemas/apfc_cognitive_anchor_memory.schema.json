{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/apfc_cognitive_anchor_memory.schema.json",
  "title": "MD-OS APFC Cognitive Anchor Memory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_id",
    "anchors",
    "transitions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "memory_id": {
      "const": "apfc_cognitive_anchor_memory"
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "anchor_id",
          "status",
          "theme_id",
          "semantic_intent",
          "uncertainty_id",
          "action_id",
          "learned_fact",
          "correction",
          "evidence_refs",
          "confidence",
          "created_at",
          "reuse_count"
        ],
        "properties": {
          "anchor_id": {
            "type": "string",
            "pattern": "^anchor_[a-f0-9]{20}$"
          },
          "status": {
            "enum": [
              "candidate",
              "verified",
              "stale",
              "falsified"
            ]
          },
          "theme_id": {
            "type": "string"
          },
          "semantic_intent": {
            "type": "string"
          },
          "uncertainty_id": {
            "type": "string"
          },
          "action_id": {
            "type": "string"
          },
          "learned_fact": {
            "type": "string"
          },
          "correction": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "reuse_count": {
            "type": "integer",
            "minimum": 0
          },
          "working_pattern": {
            "$ref": "#/$defs/working_pattern"
          },
          "verification_receipt": {
            "anyOf": [
              {
                "$ref": "epistemic_readback_receipt.schema.json"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "working_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "principle",
        "conditions",
        "prediction",
        "procedure",
        "task_bindings",
        "source_bindings"
      ],
      "properties": {
        "pattern_id": {
          "type": "string",
          "pattern": "^anchor_[a-f0-9]{20}$"
        },
        "principle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "prediction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "conditions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "procedure": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "task_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_spec_id",
              "source_path",
              "source_hash"
            ],
            "properties": {
              "task_spec_id": {
                "type": "string",
                "pattern": "^task_[a-zA-Z0-9_]+$"
              },
              "source_path": {
                "type": "string"
              },
              "source_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "source_bindings": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "verification_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  }
}
