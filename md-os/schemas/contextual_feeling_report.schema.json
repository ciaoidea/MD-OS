{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/contextual_feeling_report.schema.json",
  "title": "Contextual feeling experiment report",
  "type": "object",
  "required": ["schema_version", "experiment_id", "completed_at", "method", "cases", "metrics", "verdict", "supported_claim", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "completed_at": {"type": "string", "minLength": 1},
    "method": {"const": "paired_signal_only_vs_integrated_context_v1"},
    "cases": {"type": "array", "minItems": 2},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "control_correct", "contextual_correct", "control_accuracy", "contextual_accuracy", "accuracy_delta", "same_signal_different_action", "context_improved_choice"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 2},
        "control_correct": {"type": "integer", "minimum": 0},
        "contextual_correct": {"type": "integer", "minimum": 0},
        "control_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "contextual_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "accuracy_delta": {"type": "number", "minimum": -1, "maximum": 1},
        "same_signal_different_action": {"type": "boolean"},
        "context_improved_choice": {"type": "boolean"}
      }
    },
    "verdict": {"enum": ["verified_contextual_effect", "no_verified_contextual_effect"]},
    "supported_claim": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
