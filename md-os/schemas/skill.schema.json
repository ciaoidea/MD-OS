{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/skill.schema.json",
  "title": "MD-OS Verified Skill",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "skill_id",
    "title",
    "description",
    "status",
    "domain",
    "inputs",
    "tools",
    "preconditions",
    "procedure",
    "success_criteria",
    "failure_modes",
    "rollback",
    "evals",
    "source_episodes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "skill_id": { "type": "string", "pattern": "^skill_[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "promotable", "promoted", "deprecated", "revoked"] },
    "domain": { "type": "string", "minLength": 1 },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "tools": { "type": "array", "items": { "type": "string" } },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "procedure": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "success_criteria": { "type": "array", "items": { "type": "string" } },
    "failure_modes": { "type": "array", "items": { "type": "string" } },
    "rollback": { "type": "string", "minLength": 1 },
    "evals": { "type": "array", "items": { "type": "string" } },
    "source_episodes": { "type": "array", "items": { "type": "string" } },
    "pattern_origin": {
      "type": "object", "additionalProperties": false,
      "required": ["pattern_id", "pattern_hash", "source_outcomes", "program_signatures", "executable_cases"],
      "properties": {
        "pattern_id": { "type": "string", "pattern": "^anchor_[a-f0-9]{20}$" },
        "pattern_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_outcomes": { "type": "array", "minItems": 1, "maxItems": 3, "items": {
          "type": "object", "additionalProperties": false, "required": ["task_spec_id", "report_hash"],
          "properties": { "task_spec_id": { "type": "string", "pattern": "^task_[a-zA-Z0-9_]+$" },
            "report_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
        } },
        "program_signatures": { "type": "array", "minItems": 1, "maxItems": 3,
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "executable_cases": { "type": "array", "minItems": 1, "maxItems": 3, "items": {
          "type": "object", "required": ["task_spec_id", "actions", "observation_targets", "acceptance_tests"],
          "properties": { "task_spec_id": { "type": "string" }, "actions": { "type": "array" },
            "observation_targets": { "type": "array" }, "acceptance_tests": { "type": "array" } }
        } }
      }
    },
    "generality_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["cross_domain_transfer", "tensorial_transformation", "cognitive_unity"] }
    },
    "relative_transformation_verification_file": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$" },
    "relative_transformation_verification_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cognitive_unity_state_file": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$" },
    "cognitive_unity_state_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "generality_claims": { "minItems": 1 } }, "required": ["generality_claims"] },
      "then": { "required": ["relative_transformation_verification_file", "relative_transformation_verification_hash"] }
    },
    {
      "if": { "properties": { "generality_claims": { "contains": { "const": "cognitive_unity" } } }, "required": ["generality_claims"] },
      "then": { "required": ["cognitive_unity_state_file", "cognitive_unity_state_hash"] }
    }
  ]
}
