{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "md-os/schemas/binding_graph.schema.json",
  "title": "MD-OS (Artificial Prefrontal Cortex) Binding Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "frame_id",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "entity",
              "event",
              "relation",
              "intent",
              "state",
              "affordance",
              "risk",
              "memory",
              "action_candidate",
              "prediction",
              "error_signal",
              "experience_token",
              "frame",
              "source"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "token_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "salience": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "type",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_count",
        "edge_count",
        "density",
        "connected_component_count",
        "isolated_node_count"
      ],
      "properties": {
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "connected_component_count": {
          "type": "integer",
          "minimum": 0
        },
        "isolated_node_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
