{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.org/schemas/private_cortex_conversation_turn.schema.json",
  "title": "Private Cortex conversation turn",
  "description": "One hash-chained private conversation exchange carried only by a physical workspace copy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "artifact_role",
    "sequence",
    "recorded_at",
    "previous_hash",
    "human_inputs",
    "assistant_response",
    "event_hash"
  ],
  "properties": {
    "$schema": {
      "const": "../../../schemas/private_cortex_conversation_turn.schema.json"
    },
    "schema_version": { "const": 1 },
    "artifact_role": { "const": "private_cortex_conversation_turn" },
    "sequence": { "type": "integer", "minimum": 1 },
    "recorded_at": { "type": "string", "format": "date-time", "maxLength": 64 },
    "previous_hash": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      ]
    },
    "human_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 524288 }
    },
    "assistant_response": {
      "type": "string",
      "minLength": 1,
      "maxLength": 524288
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
