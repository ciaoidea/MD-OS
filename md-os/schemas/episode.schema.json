{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/episode.schema.json",
  "title": "MD-OS Verified AGI Episode",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "episode_id",
    "created_at",
    "task",
    "task_type",
    "task_spec",
    "task_spec_file",
    "context_pack_id",
    "plan",
    "actions",
    "observations",
    "errors",
    "artifacts",
    "action_receipts",
    "verification_result_file",
    "verifier_results",
    "verdict",
    "lessons",
    "candidate_claim_updates",
    "candidate_skills",
    "regressions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "episode_id": { "type": "string", "pattern": "^ep_[a-zA-Z0-9_]+$" },
    "created_at": { "type": "string" },
    "task": { "type": "string", "minLength": 1 },
    "task_spec": { "$ref": "task_spec.schema.json" },
    "task_spec_file": { "type": "string", "pattern": "^md-os/ops/tasks/" },
    "task_type": {
      "enum": [
        "software_repair",
        "knowledge_import",
        "identity_alignment",
        "epistemic_validation",
        "filesystem_operation",
        "hardware_operation",
        "research_task",
        "general_operation"
      ]
    },
    "risk_level": { "enum": ["low", "medium", "high"] },
    "context_pack_id": { "type": "string", "minLength": 1 },
    "plan": { "type": "array", "items": { "type": "object" } },
    "actions": { "type": "array", "items": { "type": "object" } },
    "observations": { "type": "array", "items": { "type": "object" } },
    "errors": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "action_receipts": { "type": "array", "items": { "type": "string", "pattern": "^md-os/ops/action_receipts/" } },
    "verification_result_file": { "type": "string", "pattern": "^md-os/ops/verifications/" },
    "verifier_results": { "type": "array", "items": { "$ref": "verifier.schema.json" } },
    "verdict": { "enum": ["success", "unverified", "partial", "failed"] },
    "lessons": { "type": "array", "items": { "type": "string" } },
    "candidate_claim_updates": { "type": "array" },
    "candidate_skills": { "type": "array", "items": { "type": "string" } },
    "regressions": { "type": "array" }
  }
}
