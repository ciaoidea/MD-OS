{
  "schema_version": 1,
  "contract_id": "mdos_open_affective_perception_v1",
  "identity_id": "md_os_apfc",
  "processing_stage": "pre_deliberative",
  "portable": true,
  "representation_contract": {
    "form": "open_semantic_relational_state",
