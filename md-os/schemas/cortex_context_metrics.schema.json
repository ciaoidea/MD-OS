{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/cortex_context_metrics.schema.json",
  "title": "Cortex Context Construction Metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "timestamp",
    "workspace",
    "thread_id_hash",
    "new_thread",
    "reused_thread",
    "bootstrap_sent",
    "bootstrap_hash",
    "human_request_chars",
    "human_request_bytes",
    "auxiliary_context_chars",
    "auxiliary_context_bytes",
    "estimated_auxiliary_tokens",
    "token_count_is_estimate",
    "selected_context_sources",
    "automatically_injected_memory_node_count",
    "on_demand_memory_calls",
    "on_demand_memory_result_counts",
    "duplicate_event_hashes_removed",
    "fresh_history_exchange_count",
    "shell_observation_chars",
    "shell_observation_bytes",
    "model_turns_used",
    "output_gate_verdict",
    "duration_ms"
  ],
  "properties": {
    "$schema": { "const": "../../../schemas/cortex_context_metrics.schema.json" },
    "schema_version": { "const": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "workspace": { "type": "string", "minLength": 1 },
    "thread_id_hash": { "$ref": "#/$defs/hash" },
    "new_thread": { "type": "boolean" },
    "reused_thread": { "type": "boolean" },
    "bootstrap_sent": { "type": "boolean" },
    "bootstrap_hash": { "$ref": "#/$defs/hash" },
    "human_request_chars": { "type": "integer", "minimum": 0 },
    "human_request_bytes": { "type": "integer", "minimum": 0 },
    "auxiliary_context_chars": { "type": "integer", "minimum": 0 },
    "auxiliary_context_bytes": { "type": "integer", "minimum": 0 },
    "estimated_auxiliary_tokens": { "type": "integer", "minimum": 0 },
    "token_count_is_estimate": { "const": true },
    "selected_context_sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "automatically_injected_memory_node_count": { "const": 0 },
    "on_demand_memory_calls": { "type": "integer", "minimum": 0 },
    "on_demand_memory_result_counts": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 3 }
    },
    "duplicate_event_hashes_removed": { "type": "integer", "minimum": 0 },
    "fresh_history_exchange_count": { "type": "integer", "minimum": 0, "maximum": 2 },
    "shell_observation_chars": { "type": "integer", "minimum": 0 },
    "shell_observation_bytes": { "type": "integer", "minimum": 0 },
    "model_turns_used": { "const": 1 },
    "output_gate_verdict": { "enum": ["pass", "fail"] },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
