{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/verifier.schema.json",
  "title": "MD-OS Verifier Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "verifier_id",
    "status",
    "checks",
    "outcome"
  ],
  "properties": {
    "task_spec_id": { "type": "string" },
    "task_spec_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "report_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checked_at": { "type": "string" },
    "verification_scope": { "const": "declared_local_contract" },
    "binding_errors": { "type": "array", "items": { "type": "string" } },
    "bindings": { "type": "array", "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "exists", "sha256"],
      "properties": { "path": { "type": "string" }, "exists": { "type": "boolean" },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" } }
    } },
    "verifier_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ok", "attention", "critical"] },
    "outcome": { "enum": ["verified", "unverified", "failed"] },
    "independent_from_planner": { "type": "boolean" },
    "acceptance_results": { "type": "array", "items": { "type": "object" } },
    "action_receipt_ids": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "status", "message"],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ok", "attention", "critical"] },
          "message": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
