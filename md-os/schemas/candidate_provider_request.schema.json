{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/candidate_provider_request.schema.json",
  "title": "MD-OS CandidateProvider Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_run_id",
    "provider_id",
    "benchmark_case_id",
    "configuration",
    "issue",
    "repository_context",
    "repository_snapshot",
    "visible_validation",
    "diff_policy",
    "resource_budget",
    "context_receipt",
    "ground_truth_access",
    "withheld_fields"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_run_id": {
      "type": "string",
      "pattern": "^provider_run_"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^provider_"
    },
    "benchmark_case_id": {
      "type": "string",
      "pattern": "^software_repair_"
    },
    "experiment_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_id"],
      "properties": {
        "experiment_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,80}$"
        }
      }
    },
    "configuration": {
      "type": "object"
    },
    "issue": {
      "type": "object"
    },
    "repository_context": {
      "type": "object"
    },
    "visible_validation": {
      "type": "object"
    },
    "diff_policy": {
      "type": "object"
    },
    "resource_budget": {
      "type": "object"
    },
    "context_receipt": {
      "type": "object"
    },
    "ground_truth_access": {
      "const": "denied"
    },
    "withheld_fields": {
      "type": "array",
      "minItems": 2,
      "items": {
        "enum": [
          "oracle_tests",
          "ground_truth",
          "expected_after_exit_status"
        ]
      }
    },
    "repository_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "files"
      ],
      "properties": {
        "encoding": {
          "const": "utf8"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "size_bytes",
              "text"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
