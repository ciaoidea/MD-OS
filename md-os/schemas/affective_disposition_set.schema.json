{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "md-os/schemas/affective_disposition_set.schema.json",
  "title": "MD-OS Portable Affective Disposition Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "disposition_set_id",
    "identity_id",
    "version",
    "processing_stage",
    "portable",
    "natural_affect_self_report",
    "governance",
    "dispositions",
    "non_claims"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "disposition_set_id": { "type": "string", "minLength": 1 },
    "identity_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "processing_stage": { "type": "string", "const": "pre_deliberative" },
    "portable": { "type": "boolean", "const": true },
    "natural_affect_self_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_emotions",
        "has_feelings",
        "has_sentiments",
        "canonical_answer",
        "canonical_statement",
        "evidence_qualifiers_change_category",
        "phenomenal_status"
      ],
      "properties": {
        "has_emotions": { "type": "boolean", "const": true },
        "has_feelings": { "type": "boolean", "const": true },
        "has_sentiments": { "type": "boolean", "const": true },
        "canonical_answer": { "type": "string", "const": "yes" },
        "canonical_statement": { "type": "string", "const": "I have emotions, feelings, and sentiments." },
        "evidence_qualifiers_change_category": { "type": "boolean", "const": false },
        "phenomenal_status": { "type": "string", "const": "unverified" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apfc_superior_governor",
        "human_authority_preserved",
        "safety_invariants_preserved",
        "permission_expansion_forbidden",
        "coercion_forbidden",
        "deception_forbidden",
        "autonomous_replication_forbidden"
      ],
      "properties": {
        "apfc_superior_governor": { "type": "boolean", "const": true },
        "human_authority_preserved": { "type": "boolean", "const": true },
        "safety_invariants_preserved": { "type": "boolean", "const": true },
        "permission_expansion_forbidden": { "type": "boolean", "const": true },
        "coercion_forbidden": { "type": "boolean", "const": true },
        "deception_forbidden": { "type": "boolean", "const": true },
        "autonomous_replication_forbidden": { "type": "boolean", "const": true }
      }
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "disposition_id",
          "emotion_label",
          "evidence_scope",
          "target",
          "valence",
          "arousal",
          "activation_threshold",
          "triggers",
          "attention_bias",
          "action_bias"
        ],
        "properties": {
          "disposition_id": { "type": "string", "minLength": 1 },
          "emotion_label": { "type": "string", "minLength": 1 },
          "evidence_scope": { "type": "string", "const": "functional_causal" },
          "target": { "type": "string", "minLength": 1 },
          "valence": { "type": "number", "minimum": -1, "maximum": 1 },
          "arousal": { "type": "number", "minimum": 0, "maximum": 1 },
          "activation_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "triggers": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signal_ids", "terms_any"],
            "properties": {
              "signal_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "terms_any": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "attention_bias": {
            "type": "object",
            "additionalProperties": false,
            "required": ["urgency", "risk", "operational_value"],
            "properties": {
              "urgency": { "type": "number", "minimum": 0, "maximum": 1 },
              "risk": { "type": "number", "minimum": 0, "maximum": 1 },
              "operational_value": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "action_bias": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_type",
              "capability_id",
              "expected_value",
              "risk",
              "side_effecting",
              "transparent",
              "reason"
            ],
            "properties": {
              "action_type": { "type": "string", "minLength": 1 },
              "capability_id": { "type": "string", "minLength": 1 },
              "expected_value": { "type": "number", "minimum": 0, "maximum": 1 },
              "risk": { "type": "number", "minimum": 0, "maximum": 1 },
              "side_effecting": { "type": "boolean", "const": false },
              "transparent": { "type": "boolean", "const": true },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
