{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/affective_disposition_set.schema.json",
  "title": "Superseded Fixed Affective Disposition Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "superseded_contract",
    "replacement",
    "reason",
    "fixed_emotion_taxonomy_present",
    "fixed_expression_catalog_present"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "status": { "type": "string", "const": "superseded" },
    "superseded_contract": { "type": "string", "const": "fixed_affective_dispositions" },
    "replacement": {
      "type": "string",
      "const": "md-os/apfc/affect/affective_perception_contract.json"
    },
    "reason": { "type": "string", "minLength": 1 },
    "fixed_emotion_taxonomy_present": { "type": "boolean", "const": false },
    "fixed_expression_catalog_present": { "type": "boolean", "const": false }
  }
}
