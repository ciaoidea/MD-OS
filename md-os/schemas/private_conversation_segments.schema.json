{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private conversation segment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_role",
    "sealed",
    "active",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_role": {
      "const": "private_conversation_segments"
    },
    "sealed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4095,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "record_count",
          "byte_count",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(conversation\\.ndjson|conversation-segments/[0-9]{8}\\.ndjson)$"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "active": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^conversation-segments/[0-9]{8}\\.ndjson$"
        }
      }
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
