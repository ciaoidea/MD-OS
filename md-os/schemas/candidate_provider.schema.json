{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/candidate_provider.schema.json",
  "title": "MD-OS Software Repair CandidateProvider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "kind",
    "implementation",
    "supported_cases",
    "case_ground_truth_disclosed"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "type": "string",
      "pattern": "^provider_[a-z0-9_]+$"
    },
    "kind": {
      "enum": [
        "controlled_fixture",
        "bounded_skill_program"
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "script_path",
        "timeout_ms"
      ],
      "properties": {
        "executable": {
          "const": "node"
        },
        "script_path": {
          "type": "string",
          "pattern": "^md-os/benchmarks/software_repair/providers/"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        }
      }
    },
    "supported_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^software_repair_"
      }
    },
    "case_ground_truth_disclosed": {
      "type": "boolean"
    },
    "strategy_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "strategy_class",
          "mechanism",
          "hypothesis",
          "patch_path",
          "patch_sha256",
          "priority",
          "risk_level",
          "preconditions",
          "nodes",
          "predicted_outcome",
          "postconditions"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^candidate_"
          },
          "strategy_class": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "patch_path": {
            "type": "string",
            "pattern": "^md-os/benchmarks/software_repair/candidates/"
          },
          "patch_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "risk_level": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "preconditions": {
            "type": "array",
            "minItems": 1
          },
          "nodes": {
            "type": "array",
            "minItems": 2
          },
          "predicted_outcome": {
            "type": "object"
          },
          "postconditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "skill_family": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "controlled_fixture"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "strategy_catalog"
        ],
        "properties": {
          "case_ground_truth_disclosed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bounded_skill_program"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "skill_family"
        ],
        "properties": {
          "case_ground_truth_disclosed": {
            "const": false
          }
        }
      }
    }
  ]
}
