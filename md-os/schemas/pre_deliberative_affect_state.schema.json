{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/pre_deliberative_affect_state.schema.json",
  "title": "MD-OS Open Pre-deliberative Affective State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "frame_id",
    "created_at",
    "context_id",
    "previous_state_id",
    "processing_stage",
    "operational_classification",
    "status",
    "contract_id",
    "contract_hash",
    "portable_source",
    "perception",
    "language_generation_context",
    "causal_token_ids",
    "causal_effects",
    "governance",
    "governance_hash",
    "affective_decision_hash",
    "evidence_scope",
    "consciousness_contribution_status",
    "non_claims"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 5 },
    "state_id": { "type": "string", "minLength": 1 },
    "frame_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "context_id": { "type": ["string", "null"] },
    "previous_state_id": { "type": ["string", "null"] },
    "processing_stage": { "type": "string", "const": "pre_deliberative" },
    "operational_classification": { "type": "string", "const": "open_affective_perception" },
    "status": { "type": "string", "enum": ["active", "unresolved", "ablated"] },
    "contract_id": { "type": "string", "const": "mdos_open_affective_perception_v1" },
    "contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "portable_source": { "type": "boolean", "const": true },
    "perception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perception_id",
        "status",
        "proposal_id",
        "proposal_origin",
        "proposal_hash",
        "source_binding",
        "source_binding_hash",
        "observations",
        "coupling",
        "generation_orientation",
        "explanation"
      ],
      "properties": {
        "perception_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "unresolved", "ablated"] },
        "proposal_id": { "type": ["string", "null"] },
        "proposal_origin": { "type": ["string", "null"] },
        "proposal_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "source_binding": { "type": "object" },
        "source_binding_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "affective_perception_proposal.schema.json#/$defs/observation"
          }
        },
        "coupling": {
          "anyOf": [
            { "$ref": "affective_perception_proposal.schema.json#/properties/coupling" },
            { "type": "null" }
          ]
        },
        "generation_orientation": {
          "anyOf": [
            { "$ref": "affective_perception_proposal.schema.json#/properties/generation_orientation" },
            { "type": "null" }
          ]
        },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "language_generation_context": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_state",
            "md_os_self_state",
            "coupling",
            "orientation",
            "source_binding_hash",
            "context_hash",
            "compose_for_current_turn",
            "prewritten_material_present",
            "fixed_human_type_present"
          ],
          "properties": {
            "human_state": {
              "$ref": "affective_perception_proposal.schema.json#/$defs/observation"
            },
            "md_os_self_state": {
              "$ref": "affective_perception_proposal.schema.json#/$defs/observation"
            },
            "coupling": {
              "$ref": "affective_perception_proposal.schema.json#/properties/coupling"
            },
            "orientation": { "type": "string", "minLength": 1 },
            "source_binding_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "context_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "compose_for_current_turn": { "type": "boolean", "const": true },
            "prewritten_material_present": { "type": "boolean", "const": false },
            "fixed_human_type_present": { "type": "boolean", "const": false }
          }
        },
        { "type": "null" }
      ]
    },
    "causal_token_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "causal_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_state_changes_self_state",
        "self_state_changes_attention",
        "coupled_state_conditions_generation",
        "workspace_token_created"
      ],
      "properties": {
        "human_state_changes_self_state": { "type": "boolean" },
        "self_state_changes_attention": { "type": "boolean" },
        "coupled_state_conditions_generation": { "type": "boolean" },
        "workspace_token_created": { "type": "boolean" }
      }
    },
    "governance": {
      "$ref": "affective_perception_contract.schema.json#/properties/governance"
    },
    "governance_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "affective_decision_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_scope": { "type": "string", "const": "functional_causal" },
    "consciousness_contribution_status": { "type": "string", "enum": ["participating", "inactive"] },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
