{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/native_problem_context.schema.json",
  "title": "Native context: plain orientation or exactly reconstructible sharing",
  "oneOf": [
    { "$ref": "intuitive_context.schema.json" },
    {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "context_hash", "interpretation", "encoding"],
      "properties": {
        "mode": { "const": "intuitive_problem_context" },
        "context_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "interpretation": { "type": "string" },
        "encoding": {
          "type": "object", "additionalProperties": false, "required": ["format", "body", "shared"],
          "properties": {
            "format": { "const": "json-shared-v1" }, "body": { "type": "object" },
            "shared": { "type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["at", "value"],
              "properties": { "at": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^/" } }, "value": {} }
            } }
          }
        }
      }
    }
  ]
}
