#!/usr/bin/env python3
"""Compatibility alias for the public Cortex launcher."""

from __future__ import annotations

from pathlib import Path
import runpy
import sys


BIN_DIR = Path(__file__).resolve().parent
REPOSITORY_ROOT = BIN_DIR.parents[2]
sys.argv[0] = str(REPOSITORY_ROOT / "cortex")
runpy.run_path(sys.argv[0], run_name="__main__")
