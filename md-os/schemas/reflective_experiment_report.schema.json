{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/reflective_experiment_report.schema.json",
  "title": "Reflective experiment report",
  "type": "object",
  "required": ["schema_version", "experiment_id", "completed_at", "question", "method", "direct", "reflective", "metrics", "verdict", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "completed_at": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "method": {"const": "paired_direct_vs_reflective_declared_evidence_v1"},
    "direct": {
      "type": "object",
      "required": ["candidate", "evaluation"],
      "properties": {
        "candidate": {"type": "string", "minLength": 1},
        "evaluation": {"$ref": "#/$defs/evaluation"}
      },
      "additionalProperties": false
    },
    "reflective": {
      "type": "object",
      "required": ["initial_candidate", "critique", "evidence", "revised_candidate", "evaluation"],
      "properties": {
        "initial_candidate": {"type": "string", "minLength": 1},
        "critique": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["evidence_id", "statement", "source"],
            "properties": {
              "evidence_id": {"type": "string", "minLength": 1},
              "statement": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "revised_candidate": {"type": "string", "minLength": 1},
        "evaluation": {"$ref": "#/$defs/evaluation"}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["direct_score", "reflective_score", "score_delta", "direct_passed", "reflective_passed", "reflection_improved"],
      "properties": {
        "direct_score": {"type": "number", "minimum": 0, "maximum": 1},
        "reflective_score": {"type": "number", "minimum": 0, "maximum": 1},
        "score_delta": {"type": "number", "minimum": -1, "maximum": 1},
        "direct_passed": {"type": "boolean"},
        "reflective_passed": {"type": "boolean"},
        "reflection_improved": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "verdict": {"enum": ["verified_improvement", "no_verified_improvement"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "evaluation": {
      "type": "object",
      "required": ["passed", "score", "fact_checks", "forbidden_checks"],
      "properties": {
        "passed": {"type": "boolean"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "fact_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fact_id", "passed", "required_terms"],
            "properties": {
              "fact_id": {"type": "string", "minLength": 1},
              "passed": {"type": "boolean"},
              "required_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "forbidden_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "triggered", "pattern"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "triggered": {"type": "boolean"},
              "pattern": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
