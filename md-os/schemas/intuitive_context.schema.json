{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/intuitive_context.schema.json",
  "title": "Read-only intuitive orientation, not a verified outcome or learned skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "status",
    "direction",
    "general",
    "focus",
    "next_step",
    "context_hash",
    "memory"
  ],
  "properties": {
    "mode": {
      "const": "intuitive_problem_context"
    },
    "status": {
      "const": "working_context_not_verified"
    },
    "direction": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "obstacle",
            "hypothesis",
            "discriminator",
            "status",
            "authority"
          ],
          "properties": {
            "obstacle": {
              "$ref": "#/$defs/statement"
            },
            "hypothesis": {
              "$ref": "#/$defs/statement"
            },
            "discriminator": {
              "$ref": "#/$defs/statement"
            },
            "status": {
              "const": "hypothesis"
            },
            "authority": {
              "const": "none"
            }
          }
        }
      ]
    },
    "general": {
      "type": "object",
      "required": [
        "mode",
        "partial",
        "total_problem_files",
        "problems",
        "next_cursor"
      ],
      "properties": {
        "mode": {
          "enum": [
            "problem_projection",
            "problem_map"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "total_problem_files": {
          "type": "integer",
          "minimum": 0
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "task_spec_id",
              "source_hash",
              "goal"
            ]
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "focus": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "mode",
          "problems",
          "source_evidence",
          "evidence_omitted",
          "partial"
        ],
        "properties": {
          "mode": {
            "const": "problem_projection"
          },
          "partial": {
            "const": false
          },
          "problems": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "task_spec_id",
                "source_hash",
                "source_path",
                "task_spec"
              ],
              "properties": {
                "task_spec": {
                  "type": "object"
                }
              }
            }
          },
          "source_evidence": {
            "type": "array",
            "maxItems": 8
          },
          "evidence_omitted": {
            "type": "boolean"
          }
        }
      }
    },
    "next_step": {
      "type": "string",
      "minLength": 1
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "status",
        "omitted",
        "next_cursor"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "pattern_id",
              "status",
              "principle",
              "task_ids",
              "scope",
              "review_required",
              "partial"
            ],
            "properties": {
              "pattern_id": {
                "type": "string",
                "pattern": "^anchor_[a-f0-9]{20}$"
              },
              "status": {
                "enum": [
                  "candidate",
                  "verified",
                  "stale",
                  "falsified"
                ]
              },
              "partial": {
                "type": "boolean"
              }
            }
          }
        },
        "status": {
          "const": "available"
        },
        "omitted": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
