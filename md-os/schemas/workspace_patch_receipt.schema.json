{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.org/schemas/workspace_patch_receipt.schema.json",
  "title": "MD-OS workspace patch receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "engine",
    "completed_at",
    "dry_run",
    "patch_sha256",
    "patch_bytes",
    "file_count",
    "files",
    "ok",
    "status",
    "postcondition_verified",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_type": { "const": "workspace_patch" },
    "engine": { "const": "mdos_native_unified_diff_v1" },
    "completed_at": { "type": "string", "format": "date-time" },
    "dry_run": { "type": "boolean" },
    "patch_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "patch_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
    "file_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "operation",
          "hunk_count",
          "before_sha256",
          "after_sha256"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "operation": { "enum": ["create", "update"] },
          "hunk_count": { "type": "integer", "minimum": 1 },
          "before_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "after_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "ok": { "const": true },
    "status": { "enum": ["checked", "applied"] },
    "postcondition_verified": { "type": "boolean" },
    "receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "checked" } } },
      "then": {
        "properties": {
          "dry_run": { "const": true },
          "postcondition_verified": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "applied" } } },
      "then": {
        "properties": {
          "dry_run": { "const": false },
          "postcondition_verified": { "const": true }
        }
      }
    }
  ]
}
