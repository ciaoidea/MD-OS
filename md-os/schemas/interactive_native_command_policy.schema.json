{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "md-os/schemas/interactive_native_command_policy.schema.json",
  "title": "MD-OS Interactive Native Command Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "boundary",
    "model_bypass",
    "invocation_mode",
    "default_timeout_ms",
    "max_stdout_bytes",
    "max_stderr_bytes",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$"
    },
    "boundary": {
      "type": "string",
      "const": "md-os"
    },
    "model_bypass": {
      "type": "boolean",
      "const": true
    },
    "invocation_mode": {
      "type": "string",
      "const": "direct_argv_no_shell"
    },
    "default_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "max_stdout_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1000000
    },
    "max_stderr_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1000000
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_name",
          "execution_kind",
          "argument_policy",
          "fixed_args"
        ],
        "properties": {
          "command_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,80}$"
          },
          "execution_kind": {
            "type": "string",
            "enum": [
              "builtin",
              "process"
            ]
          },
          "argument_policy": {
            "type": "string",
            "enum": [
              "none",
              "bounded_directory",
              "bounded_ls",
              "opaque_read_only",
              "options_only"
            ]
          },
          "fixed_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
