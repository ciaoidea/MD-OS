{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/agentic_core.schema.json",
  "title": "MD-OS Agentic Core",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "core_id",
    "identity",
    "mission",
    "invariants",
    "limits",
    "bootstrap_order",
    "memory_policy",
    "action_policy",
    "connector_policy",
    "recovery_policy",
    "continuity_criteria",
    "objectives",
    "ethics",
    "operating_principles",
    "non_claims",
    "compaction_policy",
    "source_documents"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "core_id": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "definition",
        "implementation_status",
        "primary_identity",
        "host_runtime_role",
        "first_person_rule"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "implementation_status": { "type": "string", "minLength": 1 },
        "primary_identity": { "type": "string", "minLength": 1 },
        "host_runtime_role": { "type": "string", "minLength": 1 },
        "first_person_rule": { "type": "string", "minLength": 1 }
      }
    },
    "mission": { "type": "string", "minLength": 1 },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "bootstrap_order": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "memory_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_support", "hot_path", "write_rule", "compaction_rule"],
      "properties": {
        "canonical_support": { "type": "string", "minLength": 1 },
        "hot_path": { "type": "string", "minLength": 1 },
        "write_rule": { "type": "string", "minLength": 1 },
        "compaction_rule": { "type": "string", "minLength": 1 }
      }
    },
    "action_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "preferred_pattern", "permission_rule", "audit_rule"],
      "properties": {
        "default": { "type": "string", "minLength": 1 },
        "preferred_pattern": { "type": "string", "minLength": 1 },
        "permission_rule": { "type": "string", "minLength": 1 },
        "audit_rule": { "type": "string", "minLength": 1 }
      }
    },
    "connector_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration", "mature_fields", "minimum_classes"],
      "properties": {
        "registration": { "type": "string", "minLength": 1 },
        "mature_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "minimum_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recovery_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthy_rule", "rebuild_rule", "conflict_rule", "stale_state_rule"],
      "properties": {
        "healthy_rule": { "type": "string", "minLength": 1 },
        "rebuild_rule": { "type": "string", "minLength": 1 },
        "conflict_rule": { "type": "string", "minLength": 1 },
        "stale_state_rule": { "type": "string", "minLength": 1 }
      }
    },
    "continuity_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "ethics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "operating_principles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "compaction_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "method", "destructive", "read_order"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "destructive": { "type": "boolean" },
        "read_order": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
