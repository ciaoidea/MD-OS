#!/usr/bin/env python3
"""Cortex entrypoint: MD-OS agentic shell plus deterministic runtime CLI."""

from __future__ import annotations

import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys
from typing import NoReturn


REPOSITORY_ROOT = Path(__file__).resolve().parent
SHELL_ENGINE = REPOSITORY_ROOT / "md-os" / "shell" / "bin" / "mdos-console"
RUNTIME_CLI = REPOSITORY_ROOT / "md-os" / "os" / "mdos.js"
RUNTIME_COMMANDS = frozenset({
    "agenda", "agi", "apfc", "apps", "archive", "audio", "audit",
    "benchmark", "boot-summary", "build", "capability", "cognition",
    "compact", "compile-programs", "compile-runtime", "connector",
    "continuity", "core", "cycle", "demo", "device", "display", "graph",
    "graphify", "hardware", "health", "hygiene", "init", "knowledge",
    "lifecycle", "live", "math", "mcp-server", "module", "paths",
    "propose-change", "replay", "role", "runtime", "screen", "self",
    "semantic", "services", "signal", "software", "wolfram", "workspace",
})


def resolve_workspace(cwd: Path) -> Path:
    """Return the stable workspace boundary used for a shared terminal."""
    resolved = cwd.resolve()
    git = shutil.which("git")
    if git is None:
        return resolved
    try:
        result = subprocess.run(
            [git, "rev-parse", "--show-toplevel"],
            cwd=resolved,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return resolved
    if result.returncode != 0 or not result.stdout.strip():
        return resolved
    try:
        return Path(result.stdout.strip()).expanduser().resolve()
    except OSError:
        return resolved


def shared_session_name(workspace: Path) -> str:
    digest = hashlib.sha256(str(workspace).encode("utf-8")).hexdigest()[:12]
    readable = "".join(
        character if character.isalnum() else "-"
        for character in workspace.name.casefold()
    ).strip("-")
    readable = readable[:32] or "workspace"
    return f"cortex-{readable}-{digest}"


def should_share_interactive_shell(arguments: list[str]) -> bool:
    if arguments or os.name == "nt":
        return False
    if os.environ.get("MDOS_SHARED_SESSION_ACTIVE") == "1":
        return False
    policy = os.environ.get("MDOS_SHARED_SESSION", "auto").strip().casefold()
    if policy in {"0", "false", "no", "never", "off"}:
        return False
    if policy not in {"", "1", "true", "yes", "always", "on", "auto"}:
        print(
            "ERROR: MDOS_SHARED_SESSION must be auto, always, or never",
            file=sys.stderr,
        )
        raise SystemExit(64)
    if shutil.which("tmux") is None:
        if policy in {"1", "true", "yes", "always", "on"}:
            print("ERROR: tmux is required for the shared Cortex session", file=sys.stderr)
            raise SystemExit(69)
        return False
    return sys.stdin.isatty() and sys.stdout.isatty()


def exec_shared_shell() -> NoReturn:
    """Attach every interactive entrypoint to one Cortex process per workspace."""
    tmux = shutil.which("tmux")
    if tmux is None:
        raise SystemExit(69)
    workspace = resolve_workspace(Path.cwd())
    session_name = shared_session_name(workspace)
    environment = os.environ.copy()
    environment["MDOS_SHARED_SESSION_ACTIVE"] = "1"
    command = [sys.executable, str(SHELL_ENGINE)]
    tmux_arguments = [
        tmux,
        "new-session",
        "-A",
        "-s",
        session_name,
        "-c",
        str(Path.cwd().resolve()),
        *command,
    ]
    # A WebSSH client may already be inside its transport tmux. Clearing TMUX
    # permits it to attach to the canonical inner Cortex session, which is also
    # reachable from a local terminal or a normal SSH login.
    environment.pop("TMUX", None)
    environment.pop("TMUX_PANE", None)
    os.execve(tmux, tmux_arguments, environment)


def exec_shell(arguments: list[str]) -> NoReturn:
    os.execv(sys.executable, [sys.executable, str(SHELL_ENGINE), *arguments])


def exec_runtime(arguments: list[str]) -> NoReturn:
    node = shutil.which("node")
    if node is None:
        print("ERROR: Node.js is required for deterministic cortex subcommands", file=sys.stderr)
        raise SystemExit(69)
    environment = os.environ.copy()
    environment["MDOS_CLI_NAME"] = "cortex"
    os.execve(node, [node, str(RUNTIME_CLI), *arguments], environment)


def main() -> int:
    arguments = sys.argv[1:]
    if not arguments:
        if should_share_interactive_shell(arguments):
            exec_shared_shell()
        exec_shell([])
    first = arguments[0]
    if first == "console":
        exec_shell(arguments[1:])
    if first in RUNTIME_COMMANDS:
        exec_runtime(arguments)
    exec_shell(arguments)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
