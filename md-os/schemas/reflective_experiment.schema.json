{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/reflective_experiment.schema.json",
  "title": "Reflective experiment task",
  "type": "object",
  "required": ["schema_version", "task_spec_id", "created_at", "goal", "constraints", "acceptance_tests", "risk_budget", "resource_budget", "required_evidence", "unknowns", "success_definition", "actions", "observation_targets", "experiment_id", "question", "direct_candidate", "revised_candidate", "evidence", "required_facts", "forbidden_claims"],
  "properties": {
    "schema_version": {"const": 1},
    "task_spec_id": {"type": "string", "pattern": "^task_[a-zA-Z0-9_]+$"},
    "created_at": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "task_type": {"type": "string"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "acceptance_tests": {"type": "array"},
    "risk_budget": {"type": "object"},
    "resource_budget": {"type": "object"},
    "required_evidence": {"type": "array"},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "success_definition": {"type": "object"},
    "actions": {"type": "array"},
    "observation_targets": {"type": "array"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "question": {"type": "string", "minLength": 1},
    "direct_candidate": {"type": "string", "minLength": 1},
    "revised_candidate": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "statement", "source"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "required_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fact_id", "all_terms"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "all_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "forbidden_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "pattern"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "pattern": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
