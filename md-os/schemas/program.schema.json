{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-os.local/schemas/program.schema.json",
  "title": "MD-OS Compiled Natural-Language Program",
  "type": "object",
  "required": ["program_id", "source_file", "trigger", "conditions", "actions", "outputs"],
  "properties": {
    "program_id": { "type": "string" },
    "source_file": { "type": "string" },
    "trigger": { "type": "string" },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "actions": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "risk_level": { "type": "string" },
    "connector_target": { "type": "string" },
    "failure_mode": { "type": "string" },
    "retry_policy": { "type": "string" },
    "audit_rule": { "type": "string" }
  },
  "additionalProperties": true
}
